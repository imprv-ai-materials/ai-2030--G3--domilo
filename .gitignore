# Sekrety (klucze API, np. OPENAI_API_KEY) — nigdy do repozytorium
.env
.env.*

# macOS
.DS_Store

# Python: wirtualne środowisko Poetry (w katalogu projektu) i pamięci podręczne narzędzi
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
coverage/
dist/

# Node (panel w ui/, gdy powstanie)
node_modules/
.next/
.pnpm-store

# Edytor
.vscode

# Baza DuckDB budowana z data/ (pypyr baza)
domilo.duckdb
domilo.duckdb.tmp
domilo.duckdb.wal

# MLflow (api/adapters/mlflow_rejestr.py): baza runów i artefakty lokalne
mlflow.db
mlartifacts/
mlruns/

# Cache odpowiedzi LLM (api/adapters/llm_client.py): dziesiątki tysięcy plików JSON. Wyniki ekstrakcji są
# w api/api/ai/features/wycena/cechy_llm/*.parquet (docs/b1_v4_llm_cechy.md).
api/api/ai/llm/cache/

# dbt (api/api/data_platform/dbt): skompilowane SQL, manifest i logi z każdego uruchomienia
api/api/data_platform/dbt/target/
api/api/data_platform/dbt/logs/

# Kolejka doradców (leasing_bc/kolejka_dzienna.py): pliki pośrednie przebiegów i stan atrapy CRM (dev/mock_lejek)
kolejka_dzienna/
dev/mock_lejek/stan*.json
dev/mock_lejek/stan*.tmp

# Lista retencyjna (retention_bc/lista_retencyjna.py): pliki pośrednie przebiegów
lista_retencyjna/

# Metabase (dev/metabase/): sterownik DuckDB, stan aplikacji (H2), dane panelu i hasło administratora (.env)
dev/metabase/plugins/
dev/metabase/stan/
dev/metabase/dane/

# Alerty o awariach wind (maintenance_bc): magazyn okien Telemetry, cechy i przebiegi dzienne, stan atrapy Serwisownika
telemetra_biezaca/
windy_dzienne/
dev/serwisownik_mock/stan*.json
dev/serwisownik_mock/stan*.tmp

# Grafana (dev/grafana/): wtyczka DuckDB, tablica generowana z szablonu, dane tablicy i hasło administratora (.env)
dev/grafana/plugins/
dev/grafana/dashboards/
dev/grafana/dane/
