# Dane kursowe (Parquet i zdjęcia) leżą w Git LFS: po sklonowaniu `git lfs pull`.
*.parquet filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text

# Skrypty kontenera zawsze z końcami linii LF (Git for Windows z core.autocrlf=true zamieniłby je na CRLF,
# a wtedy bash w kontenerze nie wystartuje).
*.sh text eol=lf
.devcontainer/* text eol=lf
